# Mini Agentic AI Platform Configuration

# Environment (development, testing, production)
AGENTOPS_ENV=development

# Logging
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///agentops.db

# Vector DB (Qdrant)
QDRANT_LOCATION=:memory:

# Security / Verification
REQUIRE_HUMAN_APPROVAL_TIER=2

# Note: Do not place real API keys in this file. 
# The prototype uses Fake Model Gateway by default.
# If testing live, set these locally:
# OPENAI_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
